<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>arcsharp</AssemblyName>
    <RootNamespace>ArcSharp</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="samples/**/*.cs" />
    <None Include="samples/**/*.cs" />
    <Compile Remove="analyzers/**/*.cs" />
    <None Include="analyzers/**/*.cs" />
    <Compile Remove="ref/**/*.cs" />
    <None Include="ref/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="analyzers/ArcSharp.Diagnostics/ArcSharp.Diagnostics.csproj" />
    <ProjectReference Include="ref/ArcSharp.References/ArcSharp.References.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <Target Name="CopyArcSharpReferences" AfterTargets="Build">
    <PropertyGroup>
      <_ArcSharpReferencesDll>$(MSBuildThisFileDirectory)ref\ArcSharp.References\bin\$(Configuration)\net11.0\ArcSharp.References.dll</_ArcSharpReferencesDll>
    </PropertyGroup>
    <Copy SourceFiles="$(_ArcSharpReferencesDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(_ArcSharpReferencesDll)')" />
  </Target>

</Project>
